  <style>
    :root {
      --govuk-generic-brand-colour: #0b0c0c;
      --govuk-generic-surface-background-colour: #f3f3f3;
      --govuk-generic-surface-border-colour: var(--govuk-border-colour);
      --govuk-generic-surface-text-colour: var(--govuk-text-colour);

      --govuk-generic-inverse-surface-background-colour:  var(--govuk-text-colour);
      --govuk-generic-inverse-surface-border-colour:  var(--govuk-text-colour);
      --govuk-generic-inverse-surface-text-colour:  var(--govuk-inverse-text-colour);

      --govuk-inverse-surface-background-colour: var(--govuk-brand-colour);
      --govuk-inverse-surface-border-colour: var(--govuk-brand-colour);
      --govuk-inverse-surface-text-colour: var(--govuk-inverse-text-colour);
    }
    /* On large screens make use of the screen */
    @media (min-width: 1900px) {
      /* make page bigger to see more content */
      .govuk-width-container {
        max-width: 95vw;
        padding-inline: 30px;
      }
      /* hack the grid so sticky positioning works correctly */
      [class^=govuk-grid] {
        all: unset;
      }
      .example-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
      }
    }
    /* Component adjustments */
    /* Prefixes */
    .govuk-input__wrapper {
      .govuk-input__prefix,
      .govuk-input__suffix {
        color: var(--govuk-surface-text-colour);
        background-color: var(--govuk-surface-background-colour);
        --govuk-input-border-colour: var(--govuk-surface-border-colour);
      }
    }
    /* Summary list */
    .govuk-summary-card {
      border-color: var(--govuk-surface-border-colour);
      .govuk-summary-card__title-wrapper {
        background-color: var(--govuk-surface-background-colour);
      }
      .govuk-summary-card__title {
        color: var(--govuk-surface-text-colour);
      }
    }
    /* Tabs */
    .govuk-tabs {
      .govuk-tabs__list,
      .govuk-tabs__list-item--selected,
      .govuk-tabs__panel {
        border-color: var(--govuk-surface-border-colour);
      }
      .govuk-summary-card {
        border-color: var(--govuk-surface-border-colour);
      }
      .govuk-tabs__list-item:not(.govuk-tabs__list-item--selected) {
        background: var(--govuk-surface-background-colour);
        .govuk-tabs__tab {
          color: var(--govuk-link-colour) !important;
        }
      }
    }
    /* Cookie banner */
    .govuk-cookie-banner {
      --govuk-text-colour: var(--govuk-surface-text-colour);
    }
    /* Header */
    .govuk-header {
      background: var(--govuk-surface-background-colour);
      --govuk-text-colour: var(--govuk-surface-text-colour);
    }
    /* Footer */
    .govuk-footer {
      background: var(--govuk-surface-background-colour);
      --govuk-text-colour: var(--govuk-surface-text-colour);
    }

    /* Themes */
    .govuk-theme--generic-inverse {
      --govuk-surface-text-colour: var(--govuk-generic-inverse-surface-text-colour);
      --govuk-surface-background-colour: var(--govuk-generic-inverse-surface-background-colour);
      --govuk-surface-border-colour: var(--govuk-generic-inverse-surface-border-colour);
      --govuk-link-colour: var(--govuk-surface-text-colour);
      --govuk-brand-colour: var(--govuk-generic-brand-colour);
    }
    .govuk-theme--generic {
      --govuk-surface-text-colour: var(--govuk-generic-surface-text-colour);
      --govuk-surface-background-colour: var(--govuk-generic-surface-background-colour);
      --govuk-surface-border-colour: var(--govuk-generic-surface-border-colour);
      --govuk-brand-colour: var(--govuk-generic-brand-colour);
    }
    .govuk-theme--inverse {
      --govuk-surface-text-colour: var(--govuk-inverse-surface-text-colour);
      --govuk-surface-background-colour: var(--govuk-inverse-surface-background-colour);
      --govuk-surface-border-colour: var(--govuk-inverse-surface-border-colour);
      --govuk-link-colour: var(--govuk-surface-text-colour);

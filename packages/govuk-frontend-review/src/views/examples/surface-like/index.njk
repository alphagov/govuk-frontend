    <div>
      {{ govukCookieBanner({
        classes: "govuk-theme--inverse",
        ariaLabel: "Cookies on [name of service]",
        messages: [
          {
            headingText: "Cookies on [name of service]",
            html: cookieBannerHtml,
            actions: [
              {
                text: "Accept analytics cookies",
                type: "button"
              },
              {
                text: "Reject analytics cookies",
                type: "button"
              },
              {
                text: "View cookies",
                href: "#"
              }
            ]
          }
        ]
      }) | replace("\"govuk-button\"", "\"govuk-button govuk-button--inverse\"") | replace("\"govuk-link\"", "\"govuk-link govuk-link--inverse\"") }}
    </div>
  </div>


{% endblock %}
{% set referenceRows = [
  [{ text: "hmcts_civil_claim_reference_2025_000123456_listed_for_hearing" }, { text: "Claimant Organisation Holdings Limited" }, { text: "listed-for-hearing" }],
  [{ text: "hmcts_family_case_reference_2025_000987654_awaiting_documents" }, { text: "Respondent Partnership LLP" }, { text: "awaiting-documents" }]

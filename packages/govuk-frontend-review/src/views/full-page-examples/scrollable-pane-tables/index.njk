{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl">Scrollable pane tables</h1>
      <p class="govuk-body">Spike</p>

      <h2 class="govuk-heading-l">1. Small table, no caption</h2>
      {{ govukTable({
        rows: smallRows
      }) }}

      <h2 class="govuk-heading-l">2. Small table with head and caption</h2>
      {{ govukTable({
        caption: "Months and rates",
        captionClasses: "govuk-table__caption--m",
        firstCellIsHeader: true,
        head: smallHead,
        rows: smallRows
      }) }}

      <h2 class="govuk-heading-l">3. Medium table</h2>
      {% set mediumRows = [] %}
      {% for row in wideRows %}
        {% set mediumRows = (mediumRows.push(row.slice(0, 7)), mediumRows) %}
      {% endfor %}
      {{ govukTable({
        caption: "HMCTS civil claims, July to October 2025",
        captionClasses: "govuk-table__caption--m",
        head: wideHead.slice(0, 7),
        rows: mediumRows
      }) }}

      <h2 class="govuk-heading-l">4. Wide table</h2>
      {{ govukTable({
        caption: "HMCTS management information, July to October 2025",
        captionClasses: "govuk-table__caption--m",
        head: wideHead,
        rows: wideRows
      }) }}

      <h2 class="govuk-heading-l">6. Long unbreakable strings</h2>
      {{ govukTable({
        caption: "Case references",
        captionClasses: "govuk-table__caption--m",
        head: [{ text: "Reference" }, { text: "Party" }, { text: "Status" }],
        rows: referenceRows
      }) }}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h2 class="govuk-heading-l">7. Wide table in a two-thirds column</h2>
      {{ govukTable({
        caption: "HMCTS management information in two-thirds",
        captionClasses: "govuk-table__caption--m",
        head: wideHead,
        rows: wideRows
      }) }}
    </div>
    <div class="govuk-grid-column-one-third">
      <h2 class="govuk-heading-m">8. Small table in a one-third column</h2>
      {{ govukTable({
        caption: "Months and rates",
        captionClasses: "govuk-table__caption--s",
        head: smallHead,
        rows: smallRows
      }) }}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h2 class="govuk-heading-l">9. Tables inside other components</h2>

      {% set insetTable %}
        {{ govukTable({
          caption: "Small table in inset text",
          head: smallHead,
          rows: smallRows
        }) }}
      {% endset %}
      {{ govukInsetText({ html: insetTable }) }}

      {% set detailsTable %}
        {{ govukTable({
          caption: "Wide table in details",
          head: wideHead,
          rows: wideRows
        }) }}
      {% endset %}
      {{ govukDetails({
        summaryText: "Show the wide table",
        html: detailsTable
      }) }}

      <h2 class="govuk-heading-l">10. Small table on a grey background</h2>
      <div style="background-color: #f3f2f1; padding: 15px;">
        {{ govukTable({
          caption: "Months and rates on grey",
          captionClasses: "govuk-table__caption--m",
          head: smallHead,
          rows: smallRows
        }) }}
      </div>
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h2 class="govuk-heading-l">11. Mixed data</h2>
        {{ govukTable({
          caption: "River levels within 5 miles of River Yealm",
          captionClasses: "govuk-table__caption--m",
          head: [
            { text: "Measuring station" },
            { text: "Height", format: "numeric" },
            { text: "Trend" },
            { text: "State" }
          ],
          rows: riverTableRows
        }) }}

        <h2 class="govuk-heading-l">12. Overwhelming table</h2>
        {{ govukTable({
          caption: "Search results for “government”",
          captionClasses: "govuk-table__caption--m",
          head: sanctionsHead,
          rows: sanctionsRows
        }) }}

        <h2 class="govuk-heading-l">13. Mixed column widths</h2>
        {{ govukTable({
          caption: "Visa application fees, join family",
          captionClasses: "govuk-table__caption--m",
          head: [
            { text: "Visa types" },
            { text: "Visa application fee (USD)", format: "numeric" }
          ],
          rows: visaRows
        }) }}

        <h2 class="govuk-heading-l">14. Wordy data</h2>
        {{ govukTable({
          caption: "Available information",
          captionClasses: "govuk-table__caption--m",
          head: [
            { text: "Information" },
            { text: "Cost" },
            { text: "What’s included" }
          ],
          rows: landRegistryRows
        }) }}

        <h2 class="govuk-heading-l">15. Links and tags</h2>
        {{ govukTable({
          caption: "EPCs for HP22 6AD",
          captionClasses: "govuk-table__caption--m",
          head: [
            { text: "Address" },
            { text: "Energy rating" },
            { text: "Valid until" }
          ],
          rows: epcRows
        }) }}

        <h2 class="govuk-heading-l">16. Super vertical table</h2>
        {{ govukTable({
          caption: "Skilled Worker eligible occupations",
          captionClasses: "govuk-table__caption--m",
          head: [
            { text: "SOC 2020 code", format: "numeric" },
            { text: "Occupation" },
            { text: "Related job titles" }
          ],
          rows: occupationRows
        }) }}
    </div>
  </div>
{% endblock %}

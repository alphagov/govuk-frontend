{% from "../../macros/attributes.njk" import govukAttributes -%}

{%- macro _govukTableCell(params) %}
  {%- set commonAttributes %}
    {%- if params.colspan %} colspan="{{ params.colspan }}"{% endif %}
    {%- if params.rowspan %} rowspan="{{ params.rowspan }}"{% endif %}
    {{- govukAttributes(params.attributes) }}
  {%- endset %}

  {%- if params.scope %}
    <th class="govuk-table__header
      {%- if params.format %} govuk-table__header--{{ params.format }}{% endif %}
      {%- if params.classes %} {{ params.classes }}{% endif %}"
      scope="{{ params.scope }}"
      {{- commonAttributes | safe }}>
      {{- params.html | safe if params.html else params.text -}}
    </th>
  {%- else %}
    <td class="govuk-table__cell
      {%- if params.format %} govuk-table__cell--{{ params.format }}{% endif %}
      {%- if params.classes %} {{ params.classes }}{% endif %}"
      {{- commonAttributes | safe }}>
      {{- params.html | safe if params.html else params.text -}}
    </td>
  {%- endif %}
{%- endmacro %}

<table class="govuk-table
  {%- if params.classes %} {{ params.classes }}{% endif %}"
  {{- govukAttributes(params.attributes) }}>
{% if params.caption %}
  <caption class="govuk-table__caption
    {%- if params.captionClasses %} {{ params.captionClasses }}{% endif %}">
    {{- params.caption -}}
  </caption>
{% endif %}
{% if params.head %}
  <thead class="govuk-table__head">
    <tr class="govuk-table__row">
    {% for cell in params.head %}
      {{ _govukTableCell({
        scope: "col",
        format: cell.format,
        classes: cell.classes,
        colspan: cell.colspan,
        rowspan: cell.rowspan,
        attributes: cell.attributes,
        html: cell.html,
        text: cell.text
      }) }}
    {% endfor %}
    </tr>
  </thead>
{% endif %}
  <tbody class="govuk-table__body">
{% for row in params.rows %}
  {% if row %}
    <tr class="govuk-table__row">
    {% for cell in row %}
      {{ _govukTableCell({
        scope: "row" if loop.first and params.firstCellIsHeader,
        format: cell.format,
        classes: cell.classes,
        colspan: cell.colspan,
        rowspan: cell.rowspan,
        attributes: cell.attributes,
        html: cell.html,
        text: cell.text
      }) }}
    {% endfor %}
    </tr>
  {% endif %}
{% endfor %}
  </tbody>
{% if params.foot %}
  <tfoot class="govuk-table__foot">
    <tr class="govuk-table__row">
    {% for cell in params.foot %}
      {{ _govukTableCell({
        scope: "row" if loop.first and params.firstCellIsHeader,
        format: cell.format,
        classes: cell.classes,
        colspan: cell.colspan,
        rowspan: cell.rowspan,
        attributes: cell.attributes,
        html: cell.html,
        text: cell.text
      }) }}
    {% endfor %}
    </tr>
  </tfoot>
{% endif %}
</table>
